ZAVU_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# DB local (dev): SQLite por defecto
# DB prod (Railway): Supabase Postgres — copiar el "Connection string > URI"
# desde Supabase > Project Settings > Database. Ejemplo:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/voiceguard.db

# En prod añadir la URL pública de Vercel (sin barra final)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app
