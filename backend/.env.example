ZAVU_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
DATABASE_URL=sqlite:///./data/voiceguard.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app

# Hugging Face — deepfake detector
# DEEPFAKE_MODEL_ID: HF model to use (default en codigo: garystafford/wav2vec2-deepfake-voice-detector)
DEEPFAKE_MODEL_ID=

# HF_USE_INFERENCE_API=1 hace que el backend llame al modelo via HF Inference API
# en lugar de descargarlo localmente. Necesario en Railway / VMs con poca RAM
# (Stafford ~1.2GB en fp32, OOMea en planes hobby).
# Sin esta var (o =0), el modelo se carga local con transformers.pipeline.
HF_USE_INFERENCE_API=

# HF_TOKEN: Token de Hugging Face. Crear gratis en https://huggingface.co/settings/tokens
# Scope: 'read' (suficiente para Inference API + descarga acelerada de modelos).
# Requerido si HF_USE_INFERENCE_API=1. Opcional pero recomendado en modo local
# para evitar rate limits al bajar el modelo.
HF_TOKEN=

# Opcional: id de un segundo modelo a correr lado a lado en /api/lab/analyze.
COMPARE_DEEPFAKE_MODEL_ID=

# Debug: cuando =1, /api/analyze guarda cada audio recibido en data/captures/
DEBUG_SAVE_AUDIO=0
